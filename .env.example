# =============================================================================
# Required — always (validated at startup by src/config/env.config.ts; the
# app will not boot if any of these are missing).
# =============================================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dare2care?schema=public"

# JWT Secrets — each must be at least 32 characters, and JWT_SECRET must not
# equal JWT_REFRESH_SECRET.
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production-32ch"

# =============================================================================
# Required — production only (NODE_ENV=production). Optional in development.
# =============================================================================

# Cron Job Secret — protects /api/cron/* (see src/middleware/cronAuth.middleware.ts).
# If unset, cron routes fail closed (401) rather than fail open.
CRON_SECRET="your-cron-secret-key"

# CORS Origins (comma-separated allow list). If unset, app.ts falls back to
# localhost dev origins with a warning — acceptable in dev, not in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# =============================================================================
# Optional — graceful degradation if absent (see the consuming module for the
# exact fallback behaviour).
# =============================================================================

JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
DIRECT_URL="postgresql://user:password@localhost:5432/dare2care?schema=public"

# Supabase (file uploads) — supabase.config.ts warns and disables uploads if absent.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Email (Resend) — email.service.ts no-ops sends if absent.
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="noreply@dare2care.org"
# Where contact-form submissions are emailed to (admin inbox)
ADMIN_NOTIFICATION_EMAIL="admin@dare2care.org"

# SMS (Twilio) — Messaging Service SID (MG...) preferred over phone number.
# sms.service.ts no-ops sends if absent.
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_MESSAGING_SERVICE_SID="your-twilio-messaging-service-sid"

# Stripe (online donations, PKR) — optional; stripe.gateway.ts degrades
# gracefully (online donations disabled) if absent. Never required, not even
# in production.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Frontend (admin/web) also need NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Server
NODE_ENV="development"
PORT=4000

# Legacy single-origin vars (kept for any code that still references them)
CORS_ORIGIN_WEB="http://localhost:3000"
CORS_ORIGIN_ADMIN="http://localhost:3001"
